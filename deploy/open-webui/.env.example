# Copy to .env and fill in. Docker Compose reads .env from this directory.

# Your provider's key. The gateway sends it on; Open WebUI never sees it.
POLANON_UPSTREAM_KEY=

# The key Open WebUI sends to the gateway. Any long random string, such as the output of
# `openssl rand -hex 16`.
POLANON_GATEWAY_KEY=

# The provider's address. Leave it out for OpenAI.
# POLANON_UPSTREAM=https://api.openai.com/v1
